      "isDeleted": false,
      "boundElements": [],
      "updated": 1783201633028,
      "link": null,
      "locked": false,
      "text": "Remove latest entry from version histroy. \nIf it was last version,that means data deleted permanantly.\nSecondary indexes updated accordingly.\nIf previous version exists,\nreinsert its secondary indexes.\nDo NOT modify append only files.\nPhysical cleanup happens during compaction.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Remove latest entry from version histroy. \nIf it was last version,that means data deleted permanantly.\nSecondary indexes updated accordingly.\nIf previous version exists,\nreinsert its secondary indexes.\nDo NOT modify append only files.\nPhysical cleanup happens during compaction.",
      "autoResize": true,
      "lineHeight": 1.25
    },
