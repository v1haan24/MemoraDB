    {
      "id": "DG8-UghPawLoXDcO_Uauy",
      "type": "text",
      "x": 3423.730744591814,
      "y": 3195.9669336593197,
      "width": 640.1972045898438,
      "height": 56.59763235044174,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3A",
      "roundness": null,
      "seed": 169296847,
      "version": 516,
      "versionNonce": 948098049,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783201088924,
      "link": null,
      "locked": false,
      "text": "The parser cannot read English. \nIt needs the Lexer to chew up the raw string and send tokens\nA C++ loop reads character by character, ignoring spaces, and builds an array of Token structs.",
      "fontSize": 15.092701960117799,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The parser cannot read English. \nIt needs the Lexer to chew up the raw string and send tokens\nA C++ loop reads character by character, ignoring spaces, and builds an array of Token structs.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "eyNksukW30fc1Mp1Q7xp_",
