      "updated": 1783201633027,
      "link": null,
      "locked": false,
      "text": "Append FULL record snapshot (not delta)\nWith each new update of data, append that version\nka offset to version histroy ka unordered map.\n\nFor any id, histroy map ka last element=latest data",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Append FULL record snapshot (not delta)\nWith each new update of data, append that version\nka offset to version histroy ka unordered map.\n\nFor any id, histroy map ka last element=latest data",
      "autoResize": true,
      "lineHeight": 1.25
    },
