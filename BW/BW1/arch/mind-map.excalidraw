      "isDeleted": false,
      "boundElements": [],
      "updated": 1783201633028,
      "link": null,
      "locked": false,
      "text": "Table Catalog\n\nStore schema of every table.\n\nFormat:\n\ntable_name\n    |\n    +-- columns\n    +-- data_types\n    +-- primary_key\n    +-- indexed_columns\n\nExample:\n\nusers:\n    id INT\n    name STRING\n    age INT\n\nPK=id",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Table Catalog\n\nStore schema of every table.\n\nFormat:\n\ntable_name\n    |\n    +-- columns\n    +-- data_types\n    +-- primary_key\n    +-- indexed_columns\n\nExample:\n\nusers:\n    id INT\n    name STRING\n    age INT\n\nPK=id",
      "autoResize": true,
      "lineHeight": 1.25
    },
