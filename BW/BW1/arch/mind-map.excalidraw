      "updated": 1783201633027,
      "link": null,
      "locked": false,
      "text": "Maintain  map of version history (in ascending \norder) for each id.\n\nform - \n        (primary_key,\n         [\n             ...\n           (timestamp,offset),\n             ...\n         ])",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Maintain  map of version history (in ascending \norder) for each id.\n\nform - \n        (primary_key,\n         [\n             ...\n           (timestamp,offset),\n             ...\n         ])",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ntw_oHvrTONbMn192pu7U",
