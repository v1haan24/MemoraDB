        }
      ],
      "updated": 1783201633028,
      "link": null,
      "locked": false,
      "text": "If RAM usage becomes excessive:\n\n1. Sparse temporal indexes can be used.\n2. Historical indexes can be paged to disk.\n3. Memory mapped indexes (mmap) may be adopted.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If RAM usage becomes excessive:\n\n1. Sparse temporal indexes can be used.\n2. Historical indexes can be paged to disk.\n3. Memory mapped indexes (mmap) may be adopted.",
      "autoResize": true,
      "lineHeight": 1.25
    },
